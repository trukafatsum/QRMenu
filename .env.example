# Copy this file to .env for local development; never commit .env.
# Run npm ci, then npm run admin:setup in an interactive terminal.
# Copy the generated values below (no quotes required).
ADMIN_EMAIL=
# Full salt:hash output, NOT your plain-text password.
ADMIN_PASSWORD_HASH=
# On Netlify, set these in the project environment (Functions scope).
# QR uses the current site URL; no VITE_PUBLIC_MENU_URL is needed.
